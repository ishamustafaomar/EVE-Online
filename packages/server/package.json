{
  "name": "@starweft/server",
  "version": "0.1.0",
  "description": "STARWEFT authoritative server: gateway (auth, rate limits, validation), 4 Hz system cells, market/industry services, persistence.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@starweft/core": "workspace:*",
    "@starweft/protocol": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@starweft/client-sdk": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
