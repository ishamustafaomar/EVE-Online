{
  "name": "@starweft/web",
  "version": "0.1.0",
  "private": true,
  "description": "STARWEFT solo browser sandbox: the real simulation (World/SystemCell/MarketService) run in-process client-side, no server, no network — for public/play.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b && node scripts/build.mjs",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run"
  },
  "dependencies": {
    "@starweft/core": "workspace:*",
    "@starweft/protocol": "workspace:*",
    "@starweft/server": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
